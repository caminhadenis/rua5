# Copy values into Render's Environment panel. Never commit the real credentials.
SPRING_PROFILES_ACTIVE=production
DB_URL=jdbc:postgresql://ep-REPLACE.REGION.aws.neon.tech:5432/neondb?sslmode=require
DB_USER=REPLACE_WITH_NEON_ROLE
DB_PASSWORD=REPLACE_WITH_NEON_PASSWORD
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m
# Render supplies PORT automatically. No API URL or database secret goes into Vite.
